# ── Copy to .env (local). On Render add the same keys under Environment.
# Never commit .env — it holds secrets.

# Server
PORT=8000
# "production" on Render: secure cookies (SameSite=None) and generic error messages
NODE_ENV=development
# Render sits behind 1 proxy. If Profile → Active sessions shows the same IP for everyone, try 2.
TRUST_PROXY=1

# Frontend URL(s) allowed to call the API, comma-separated, no trailing slash
CLIENT_URL=http://localhost:5173

# Database (MongoDB Atlas connection string). Use a SEPARATE database for production.
MONGO_URI=

# JWT secret — 64+ random characters:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ACCESS_TOKEN_SECRET=

# Gym identity (used in emails, member IDs and receipt numbers)
GYM_NAME=Hulk Gym
GYM_USER_ID_PREFIX=hulkgym
GYM_RECEIPT_PREFIX=HLK

# Razorpay — rzp_test_… for testing, rzp_live_… for production
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# The secret YOU type when creating the webhook in the Razorpay dashboard
RAZORPAY_WEBHOOK_SECRET=

# Email — Brevo (required on Render: SMTP ports are blocked there)
BREVO_API_KEY=
# A sender verified in Brevo (ideally on the gym's own domain)
BREVO_SENDER_EMAIL=
# Local-only fallback: Gmail + App Password (used when BREVO_API_KEY is empty)
EMAIL_USER=
EMAIL_PASS=
# true = print emails to the console instead of sending (local testing)
SKIP_EMAIL=false

# Members' government ID numbers are stored encrypted with this key.
# 64 hex characters. Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep a separate backup — if it is lost, saved ID numbers can never be read again.
# Do not change it later; the same key must be used on every server that uses this database.
ID_ENCRYPTION_KEY=

# Cloudinary (profile photos)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
