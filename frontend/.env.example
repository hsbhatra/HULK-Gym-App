# ── Copy to .env (local) and add the same keys in Netlify → Site settings → Environment variables
# All VITE_* values are public (they end up in the browser bundle). Never put secrets here.

# API
VITE_API_URL=http://localhost:8000/api/v1

# Public URL of this site (used for canonical links, sitemap, share previews)
VITE_SITE_URL=https://hulk-gym-kota-test.netlify.app

# ── Gym (leave a value empty to hide it on the site)
VITE_GYM_NAME=HULK GYM
VITE_GYM_CITY=Kota
VITE_GYM_PHONE=+918955363976
# WhatsApp number, if different from the calling number
VITE_GYM_WHATSAPP=
# Leave empty until the mailbox exists, otherwise enquiries bounce
VITE_GYM_EMAIL=
VITE_GYM_INSTAGRAM_URL=https://www.instagram.com/hulk.gym___/
VITE_GYM_ADDRESS=Main Road, Kota, Rajasthan
# Optional: exact Google Maps share link (otherwise built from the address)
VITE_GYM_MAPS_URL=
# Opening hours live in src/content/gymContent.js (HOURS) — they also feed Google's structured data

# ── Developer credit in the footer
VITE_DEV_NAME=Himanshu Sharma
VITE_DEV_PHONE=
# WhatsApp number, if different from the calling number
VITE_DEV_WHATSAPP=
VITE_DEV_EMAIL=
# Portfolio / LinkedIn
VITE_DEV_URL=
